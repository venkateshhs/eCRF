# Hosted/server example. Packaged executables select local filesystem mode
# automatically and do not require this file.
ECRF_ENV=production
ECRF_PROFILE=server
ECRF_BIND_HOST=0.0.0.0
ECRF_PORT=8000
ECRF_OPEN_BROWSER=0

ECRF_DATA_DIR=/srv/casee
BIDS_ROOT=/srv/casee/bids_datasets
ECRF_TEMPLATES_DIR=/opt/casee/eCRF_backend/templates
ECRF_DATABASE_URL=postgresql+psycopg2://casee:change-me@localhost/casee
ECRF_DB_AUTO_CREATE=0
ECRF_ALLOW_SQLITE_IN_PRODUCTION=0

ECRF_SECRET_KEY=change-me
ECRF_CORS_ALLOW_ORIGINS=https://casee.example.org
ECRF_BOOTSTRAP_ADMIN=0

# These are inferred for a production/server profile, but remain available
# as explicit deployment overrides.
ECRF_DATALAD_MODE=primary
ECRF_DATALAD_SYNC_MODE=sync
ECRF_DATALAD_GIT_NAME=case-e service
ECRF_DATALAD_GIT_EMAIL=case-e@example.org
ECRF_DATALAD_PUSH_ON_SAVE=1
ECRF_DATALAD_RIA_URL=ria+ssh://casee@example.org:/srv/casee-ria
ECRF_DATALAD_RIA_NAME=ria
ECRF_DATALAD_REQUIRE_RIA_FOR_WRITES=1
