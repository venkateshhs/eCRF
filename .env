# ---------------------------------------------------------------------------
# Runtime profile
# ---------------------------------------------------------------------------
# ECRF_ENV:
#   Current value "production" tells the backend to run with production checks.
#   Hosting: keep "production" for the hosted server.
ECRF_ENV=production

# ECRF_PROFILE:
#   Current value "server" selects the server/hosted startup profile.
#   Hosting: keep "server" for hosted deployment.
ECRF_PROFILE=server

# ---------------------------------------------------------------------------
# HTTP server binding
# ---------------------------------------------------------------------------
# ECRF_BIND_HOST:
#   Current value "127.0.0.1" binds FastAPI only to localhost.
#   Hosting: keep this if a reverse proxy such as nginx exposes the app.
#   Change to "0.0.0.0" only when the app itself must listen on all interfaces.
ECRF_BIND_HOST=127.0.0.1

# ECRF_PORT:
#   Current value "8000" is the backend HTTP port.
#   Hosting: change only if the deployment uses a different internal port.
ECRF_PORT=8000

# ECRF_OPEN_BROWSER:
#   Current value here is "0", meaning do not auto-open a browser.
#   Note: this variable is set again below to "1"; the later value usually wins.
#   Hosting: normally use "0" on a headless server.
ECRF_OPEN_BROWSER=0

# ---------------------------------------------------------------------------
# Local storage paths
# ---------------------------------------------------------------------------
# ECRF_DATA_DIR:
#   Base directory for hosted app data on the JTrack machine.
#   Hosting: change this to the deployed server's persistent data directory.
ECRF_DATA_DIR=/Users/vshivashankar/Desktop/case-e hosted

# BIDS_ROOT:
#   Directory where local JTrack DataLad study datasets are stored.
#   Each study gets its own folder here, for example study_4_i-check-heart.
#   Hosting: change this to a reliable persistent disk path on JTrack.
BIDS_ROOT=/Users/vshivashankar/Desktop/case-e hosted/bids_datasets

# ECRF_TEMPLATES_DIR:
#   Directory containing backend template resources such as ontologies/fields.
#   Hosting: change this to the templates directory in the deployed codebase.
ECRF_TEMPLATES_DIR=/Users/vshivashankar/Desktop/eCRF/eCRF/eCRF_backend/templates

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# ECRF_DATABASE_URL:
#   Current value uses a local SQLite database file.
#   Hosting: for the current hosted single-server setup, point this to the
#   persistent ecrf.db path. For multi-server production, use a real DB URL.
ECRF_DATABASE_URL=sqlite:////Users/vshivashankar/Desktop/case-e hosted/ecrf.db

# ECRF_DB_AUTO_CREATE:
#   Current value "1" lets the app create missing DB tables on startup.
#   Hosting: acceptable for this lightweight hosted setup; use migrations for
#   stricter production operations.
ECRF_DB_AUTO_CREATE=1

# ECRF_ALLOW_SQLITE_IN_PRODUCTION:
#   Current value "1" explicitly allows SQLite even with ECRF_ENV=production.
#   Hosting: keep only if SQLite is intentionally used on a reliable disk.
ECRF_ALLOW_SQLITE_IN_PRODUCTION=1

# ---------------------------------------------------------------------------
# Authentication and session behavior
# ---------------------------------------------------------------------------
# ECRF_SECRET_KEY:
#   Signs JWT/session tokens. Changing it logs out existing users.
#   Hosting: MUST be replaced with a private, deployment-specific secret.
ECRF_SECRET_KEY="acde070d-8c4c-4f0d-9d8a-162843c10333"

# ECRF_JWT_ALGORITHM:
#   Current value "HS256" is the JWT signing algorithm.
#   Hosting: keep unless backend auth code is changed.
ECRF_JWT_ALGORITHM=HS256

# ECRF_PASSWORD_HASHING_ENABLED:
#   Current value "1" enables password hashing.
#   Hosting: keep enabled.
ECRF_PASSWORD_HASHING_ENABLED=1

# ECRF_SHARED_LINK_VIEW_TTL_MINUTES:
#   Current value "120" keeps shared-link view activity alive for 2 hours.
#   This prevents sync cleanup while an external shared-link user is filling data.
#   Hosting: change only if shared forms need a shorter/longer edit window.
ECRF_SHARED_LINK_VIEW_TTL_MINUTES=120

# ---------------------------------------------------------------------------
# Browser/CORS and bootstrap admin
# ---------------------------------------------------------------------------
# ECRF_CORS_ALLOW_ORIGINS:
#   Comma-separated frontend origins allowed to call the backend.
#   Current value allows localhost and a placeholder APP_SERVER_IP.
#   Hosting: replace/add the real frontend origin, domain, or server IP.
ECRF_CORS_ALLOW_ORIGINS=http://127.0.0.1,http://APP_SERVER_IP

# ECRF_OPEN_BROWSER:
#   Current value "1" appears later than the earlier "0", so it is usually
#   the effective value. It opens a browser when server.py starts.
#   Hosting: set to "0" on a headless/server deployment.
ECRF_OPEN_BROWSER=1

# ECRF_BOOTSTRAP_ADMIN:
#   Current value "1" creates/seeds the default admin if missing.
#   Hosting: keep for initial setup, then consider disabling after admin exists.
ECRF_BOOTSTRAP_ADMIN="1"

# Default bootstrap admin identity.
# Hosting: change these before first deployment, especially the password.
ECRF_ADMIN_USERNAME=admin
ECRF_ADMIN_EMAIL=admin@example.com
ECRF_ADMIN_PASSWORD=Admin@123
ECRF_ADMIN_FIRST_NAME=Admin
ECRF_ADMIN_LAST_NAME=User
ECRF_ADMIN_ROLE=Administrator

# ---------------------------------------------------------------------------
# DataLad/JTrack behavior
# ---------------------------------------------------------------------------
# ECRF_DATALAD_MODE:
#   Current value "primary" means JTrack local DataLad datasets are the working
#   source used by the app, with Juseless as the remote sync target.
#   Hosting: keep "primary" for the current JTrack-hosted architecture.
ECRF_DATALAD_MODE=primary

# ECRF_DATALAD_SYNC_MODE:
#   Current value "sync" means DataLad save operations run synchronously.
#   Hosting: keep "sync" for safer write semantics.
ECRF_DATALAD_SYNC_MODE=sync

# Git author used for DataLad commits made by the service.
# Hosting: change to the service account/display identity for the deployment.
ECRF_DATALAD_GIT_NAME=case-e service
ECRF_DATALAD_GIT_EMAIL=case-e@example.org

# ECRF_DATALAD_PUSH_ON_SAVE:
#   Current value "0" means ordinary saves commit locally on JTrack but do not
#   immediately push to Juseless. Logout/shared-submit/background cleanup syncs later.
#   Hosting: keep "0" if saves must not depend on Juseless latency/availability.
ECRF_DATALAD_PUSH_ON_SAVE=0

# ECRF_DATALAD_PUSH_DATA_MODE:
#   Current value "auto-if-wanted" lets DataLad decide annex data transfer based
#   on wanted/needed data. This is used during sync to Juseless.
#   Hosting: keep unless the DataLad remote policy changes.
ECRF_DATALAD_PUSH_DATA_MODE=auto-if-wanted

# ECRF_DATALAD_VERIFY_PUSH:
#   Current value "1" verifies the Juseless push before local cleanup/removal.
#   Hosting: keep enabled for safety.
ECRF_DATALAD_VERIFY_PUSH=1

# ECRF_DATALAD_DROP_AFTER_PUSH:
#   Current value "0" keeps local annex content after push.
#   Hosting: keep "0" unless disk space requires dropping annex content.
ECRF_DATALAD_DROP_AFTER_PUSH=0

# ECRF_DATALAD_GET_ON_OPEN:
#   Current value "1" gets required DataLad content when opening/cloning studies.
#   Hosting: keep enabled so locally reopened studies have usable files.
ECRF_DATALAD_GET_ON_OPEN=1

# ---------------------------------------------------------------------------
# Juseless remote repositories and readable mirror
# ---------------------------------------------------------------------------
# ECRF_DATALAD_SSH_REMOTE_TEMPLATE:
#   Current value creates/uses one bare Git/DataLad repo per study on Juseless.
#   "{study}" is replaced with the local dataset folder name.
#   Hosting: change username, host, and base path to the production Juseless path.
ECRF_DATALAD_SSH_REMOTE_TEMPLATE=ssh://vshivashankar@juseless.inm7.de/home/vshivashankar/casee-bids-datasets/{study}.git

# ECRF_DATALAD_RIA_URL:
#   Previous RIA-store mode. Leave commented/disabled when
#   ECRF_DATALAD_SSH_REMOTE_TEMPLATE is used.
# ECRF_DATALAD_RIA_URL=

# ECRF_JUSELESS_MIRROR_AFTER_PUSH:
#   Current value "1" updates a readable worktree mirror on Juseless after push.
#   This lets admins inspect actual files, not only bare .git repositories.
#   Hosting: keep "1" if admins need readable study folders on Juseless.
ECRF_JUSELESS_MIRROR_AFTER_PUSH=1

# ECRF_JUSELESS_STUDIES_DIR:
#   Directory on Juseless where readable study worktrees are cloned/updated.
#   Hosting: change to the production readable studies directory.
ECRF_JUSELESS_STUDIES_DIR=/home/vshivashankar/casee-studies

# ECRF_JUSELESS_SSH_PASSWORD:
#   Current value enables password-based SSH using sshpass.
#   Hosting: leave empty/remove this and use SSH keys or a service account.
#   Requires sshpass if set.
ECRF_JUSELESS_SSH_PASSWORD=

# ECRF_JUSELESS_SSH_CONNECT_TIMEOUT_SECONDS:
#   SSH connection timeout only. This is not a DataLad clone/download timeout.
#   Keep low so unavailable Juseless fails fast, while large valid studies can
#   continue fetching after the SSH connection is established.
#   Hosting: 15 seconds is a good default.
ECRF_JUSELESS_SSH_CONNECT_TIMEOUT_SECONDS=15

# Production examples:
#   Use a service account with SSH key access, not a password.
#   Update paths/usernames to match the real Juseless deployment.
# ECRF_DATALAD_RIA_URL=ria+ssh://casee@juseless.inm7.de:/data/project/JTrack/CaseE/casee-ria-store
# ECRF_DATALAD_SSH_REMOTE_TEMPLATE=ssh://jfischer@juseless.inm7.de/data/project/JTrack/CaseE/bids_datasets/{study}.git
# ECRF_JUSELESS_MIRROR_AFTER_PUSH=1
# ECRF_JUSELESS_STUDIES_DIR=/data/project/JTrack/CaseE/studies

# ECRF_DATALAD_RIA_NAME:
#   Logical DataLad remote/sibling name used by older RIA mode.
#   With SSH remote template, the code uses origin for the SSH remote.
#   Hosting: keep unless using RIA mode and choosing a different sibling name.
ECRF_DATALAD_RIA_NAME=ria

# ECRF_DATALAD_REQUIRE_RIA_FOR_WRITES:
#   Current value "1" means remote configuration is required for write workflows.
#   Hosting: keep enabled so studies are not created without a configured remote.
ECRF_DATALAD_REQUIRE_RIA_FOR_WRITES=1

# ECRF_DATALAD_GPGSIGN:
#   Current value "0" disables GPG signing for service commits.
#   Hosting: set "1" only if the service account has a working GPG key.
ECRF_DATALAD_GPGSIGN=0

# ECRF_DATALAD_GPG_KEYID:
#   GPG key ID used when commit signing is enabled.
#   Current value is empty because signing is disabled.
ECRF_DATALAD_GPG_KEYID=

# ECRF_DATALAD_LOCK_TIMEOUT_SECONDS:
#   Current value "120" waits up to 120 seconds for a per-study DataLad lock.
#   Hosting: increase only if large file operations often exceed this wait.
ECRF_DATALAD_LOCK_TIMEOUT_SECONDS=120

# ECRF_STUDY_ACTIVITY_SYNC_INTERVAL_SECONDS:
#   Optional. Not set here, so the backend default is 300 seconds.
#   Controls the background retry loop for failed syncs, stale activity rows,
#   and pending Juseless deletes. Set to 0 to disable the background loop.
# ECRF_STUDY_ACTIVITY_SYNC_INTERVAL_SECONDS=300
