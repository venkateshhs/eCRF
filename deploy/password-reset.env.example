# Enable only after the SMTP and public URL values below have been confirmed.
ECRF_PASSWORD_RESET_ENABLED=1

# Public browser URL. The emailed link will be:
#   ${ECRF_FRONTEND_BASE_URL}/reset-password?token=...
ECRF_FRONTEND_BASE_URL=https://ecrf.example.org

# SMTP values supplied by the mail/infrastructure administrator.
ECRF_SMTP_HOST=smtp.example.org
ECRF_SMTP_PORT=587
ECRF_SMTP_USERNAME=casee@example.org
ECRF_SMTP_PASSWORD=CHANGE_ME
ECRF_SMTP_STARTTLS=1
ECRF_SMTP_SSL=0
ECRF_SMTP_TIMEOUT_SECONDS=15
ECRF_MAIL_FROM=casee@example.org

# Security defaults. Normally these do not need to be changed.
ECRF_PASSWORD_RESET_TTL_MINUTES=20
ECRF_PASSWORD_RESET_CONFIRMATION_TTL_MINUTES=10
ECRF_PASSWORD_RESET_MAX_PER_USER_HOUR=3
ECRF_PASSWORD_RESET_MAX_LOOKUPS_PER_IP_HOUR=10

# Keep enabled when FastAPI is reached through the supplied Apache proxy.
ECRF_TRUST_PROXY_HEADERS=1
